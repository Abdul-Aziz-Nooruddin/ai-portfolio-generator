{
  "mcpServers": {
    "magnific": {
      "command": "npx",
      "args": ["-y", "@magnific-ai/mcp@latest"],
      "env": {
        "MAGNIFIC_API_URL": "https://mcp.magnific.com"
      }
    },
    "twentyfirst": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@latest"]
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"
      }
    }
  }
}
