# ==========================================
# MyFolio Web Platform - Environment Template
# ==========================================

# === Core AI Engine (Gemini) ===
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# === Security & Password Encryption ===
AUTH_PEPPER=YOUR_SECURE_AUTH_PEPPER_HERE

# === Production Host & App Settings ===
PORT=5050
NODE_ENV=development
HOST_URL=https://myfolio.tech

# === Super Administrator Accounts ===
ADMIN_EMAILS=abdulaziznoor9876@gmail.com
ADMIN_USERNAMES=abdulazizpro1

# === Database (Supabase) ===
# Get from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# === Google Social Authentication (OAuth 2.0) ===
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# === GitHub API (Repo Intelligence) ===
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE

# === Deployment & Payment Services (Optional) ===
NETLIFY_TOKEN=YOUR_NETLIFY_TOKEN_HERE
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# === Telegram Bot Integration (Optional) ===
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=ai_portfolio_generator_bot
