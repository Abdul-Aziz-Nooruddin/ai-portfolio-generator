# WhatsApp Portfolio Bot - Environment Variables
# Fill in your actual API keys below (never commit this file to git)

# === Google AI Studio (Gemini) ===
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
AUTH_PEPPER=portfolio-bot-production-secure-pepper-entropy-2026

# === Supabase Database ===
# Get from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# === WhatsApp Business API (Meta) ===
# Get from: https://developers.facebook.com -> Your App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=YOUR_WHATSAPP_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID_HERE
WHATSAPP_WEBHOOK_VERIFY_TOKEN=YOUR_RANDOM_VERIFY_TOKEN_HERE
WHATSAPP_APP_SECRET=YOUR_APP_SECRET_HERE

# === Netlify Hosting ===
# Get from: https://app.netlify.com/user/settings/applications#personal-access-tokens
NETLIFY_TOKEN=YOUR_NETLIFY_TOKEN_HERE

# === Razorpay Payments ===
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# === Telegram Bot (Frictionless / Recommended) ===
# Get from Telegram: Message @BotFather and send /newbot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# === Zero-KYC Payments (Optional) ===
# Your personal UPI ID for direct bank transfers (e.g. yourname@okhdfcbank)
PERSONAL_UPI_ID=YOUR_UPI_ID_HERE

# === Figma MCP Integration ===
# Get from: https://www.figma.com/settings -> Account -> Personal access tokens
FIGMA_ACCESS_TOKEN=YOUR_FIGMA_PERSONAL_ACCESS_TOKEN_HERE

# === App & Hosting Config ===
PORT=3000
NODE_ENV=development
HOST_URL=http://localhost:3000
ADMIN_USERNAMES=abdulazizpro1
